# Supabase project settings. These public values may be used in the browser.
# Leave empty until Supabase integration is implemented.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only admin key; never expose through NEXT_PUBLIC_* or client imports.
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for gateway encryption: 32 random bytes encoded as base64.
# Not consumed until payment configuration is implemented.
GATEWAY_ENCRYPTION_KEY=
